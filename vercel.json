{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "openview-landing.vercel.app" }],
      "destination": "https://openviewiptv.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "openview-landing.vercel.app" }],
      "destination": "https://openviewiptv.com/:path*",
      "permanent": true
    },
    {
      "source": "/apk",
      "destination": "https://github.com/LuisPCFialho/openview-releases/releases/latest/download/OpenViewIPTV.apk",
      "permanent": false
    },
    {
      "source": "/tv",
      "destination": "https://github.com/LuisPCFialho/openview-releases/releases/latest/download/OpenViewIPTV.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/estatisticas/script.js", "destination": "https://analytics.openviewiptv.com/matomo.js" },
    { "source": "/estatisticas/registo", "destination": "https://analytics.openviewiptv.com/matomo.php" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.openviewiptv.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://analytics.openviewiptv.com; connect-src 'self' https://api.github.com https://openview-activation.luispcfialho.workers.dev https://analytics.openviewiptv.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(styles\\.css|script\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
